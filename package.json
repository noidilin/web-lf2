{
  "name": "web-lf2",
  "private": true,
  "packageManager": "pnpm@11.5.3",
  "type": "module",
  "scripts": {
    "build:static": "node scripts/build-static.mjs",
    "check:static": "node scripts/check-static.mjs",
    "typecheck": "pnpm run check:static",
    "test": "node --test tests/*.test.mjs",
    "pretest:e2e": "pnpm run build:static",
    "test:e2e": "playwright test",
    "test:lobby:image": "docker build --target test apps/lobby",
    "test:lobby": "docker compose up -d lobby && node --test tests/lobby-contract.test.mjs"
  },
  "devDependencies": {
    "playwright": "^1.52.0"
  }
}
